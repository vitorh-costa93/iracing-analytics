# MUST be issued by iRacing. Do not invent this value.
IRACING_CLIENT_ID=
IRACING_CLIENT_SECRET=
# Must exactly match a redirect URI registered for the client.
IRACING_REDIRECT_URI=http://127.0.0.1:3000/api/auth/iracing/callback
IRACING_SCOPE=iracing.auth iracing.profile
SESSION_SECRET=replace-with-32-plus-random-characters
